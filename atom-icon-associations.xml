<application>
  <component name="Atom Icon Selections Config">
    <option name="selectedFileAssociations">
      <SelectedAssociations>
        <option name="associationsList">
          <RegexAssociation>
            <option name="matcher" value=".*\.meta(data)?$" />
            <option name="pattern" value=".*\.meta(data)?$" />
            <option name="defaultState" value="false" />
            <option name="touched" value="true" />
            <option name="name" value="Metadata" />
            <option name="icon" value="/icons/files/metadata.svg" />
            <option name="iconColor" value="FFC61B" />
            <option name="folderColor" />
            <option name="folderIconColor" />
            <option name="iconPack" />
          </RegexAssociation>
        </option>
      </SelectedAssociations>
    </option>
    <option name="selectedFolderAssociations">
      <SelectedAssociations>
        <option name="iconType" value="FOLDER" />
        <option name="associationsList">
          <RegexAssociation>
            <option name="matcher" value="^[\._]?(query|queries)$" />
