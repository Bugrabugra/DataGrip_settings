          <RegexAssociation>
            <option name="matcher" value="^[\._]?(sql|mysql|pgsql|maria(db)?)$" />
            <option name="pattern" value="^[\._]?(sql|mysql|pgsql|maria(db)?)$" />
            <option name="defaultState" value="false" />
            <option name="touched" value="true" />
            <option name="iconType" value="FOLDER" />
            <option name="name" value="SQL" />
            <option name="icon" value="/sql.svg" />
            <option name="iconColor" />
            <option name="folderColor" value="0288D1" />
            <option name="folderIconColor" value="b2dfdb" />
            <option name="iconPack" />
          </RegexAssociation>
        </option>
      </SelectedAssociations>
    </option>
  </component>
</application>